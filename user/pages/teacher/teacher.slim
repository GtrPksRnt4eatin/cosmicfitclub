<!DOCTYPE html>

html

  head

    == no_scaling

    title Cosmic Fit Club

    ==css ['fonts', 'site', 'header', 'footer', 'user/teacher']
    ==js  ['jquery', 'rivets', 'moment', 'rv_dates', 'lib', 'element', 'ev_channel', '/auth/elements/userview', 'menu', 'user/teacher']

  body
  
    #stars
      
    .content

      - staff = (customer && (customer.staff || Staff.where(customer_id: customer.id).first)) unless defined?(staff)
      - schedules = staff ? staff.schedules.select{ |x| x[:classdef_id] != 78 }.map { |sched| { id: sched.id, classdef_name: sched.classdef.name, rrule: sched.rrule_english, start_time: sched.start_time_12hr } } : []

      .tile.tile_ib
        .title Currently Scheduled Classes
        .schedules
          .schedule rv-each-s='data.schedules'
            span.name { s.classdef_name }
            span.rrule { s.rrule }
            span.time { s.start_time }

      br

      - upcoming = staff ? staff.schedules.select{ |x| x[:classdef_id] != 78 }.map { |sched| next_time = (sched.next_occurrence(Time.now) rescue nil); next nil if next_time.nil?; occ = (ClassOccurrence.find(:classdef_id => sched.classdef.id, :staff_id => staff.id, :starttime => next_time.to_time.iso8601) rescue nil); headcount = occ ? occ.headcount : 0; reservations = (occ && headcount > 0) ? occ.reservation_list.map { |r| { id: r[:id], customer_name: r[:customer_name], checked_in: !!r[:checked_in] } } : []; { sched_id: sched.id, classdef_id: sched.classdef.id, classdef_name: sched.classdef.name, starttime: next_time.to_time.iso8601, headcount: headcount, reservations: reservations } }.compact : []

      javascript:
        data = {}
        data['schedules'] = #{{ schedules.to_json }};
        data['upcoming'] = #{{ upcoming.to_json }};
        data['customer'] = #{{ (customer ? customer.to_list_hash : {}).to_json }};
        data['staff'] = #{{ (staff ? staff.to_list_hash : {}).to_json }};

      .tile.tile_ib.upcoming
        .title Upcoming Classes
        hr
        .upcoming-list
          .occurrence rv-each-occ='data.upcoming'
            span.name { occ.classdef_name }
            span.time { occ.starttime | shortdt }
            span.headcount Headcount: { occ.headcount }
            .attendees rv-if='occ.headcount'
              div.attendee rv-each-res='occ.reservations'
                span { res.customer_name }
                span.checkin rv-if='res.checked_in' ✓ Checked In
                button.checkin-btn rv-unless='res.checked_in' rv-attr-data-reservation='res.id' Check In

      - if staff
        - @class_history = staff.class_history
      - else
        - @class_history = { :total_classes => 0, :avr_headcount => 0, :mvp_list => [], :hist_list => [], :grouped_list => [] }

      .tile.tile_ib.class_history
        .title Grand Total ( All Classes )
        hr
        .stats
          div Classes Taught:    #{ @class_history[:total_classes] }
          div Average Headcount: #{ @class_history[:avr_headcount] }
        hr
        div 
          | MVP List: 
          .mvp_list
            - @class_history[:mvp_list].each do |mvp|
              div.mvp
                span #{ mvp[:count]         }
                span #{ mvp[:customer_name] }
        hr
        div 
          | History:
          .history_list
            - @class_history[:hist_list].each do |hist|
              div.class_occ
                span #{ hist[:starttime].strftime("%Y %a %b %e %l:%M %P") }
                span #{ hist[:classdef_name] }
                span #{ hist[:count]         }

      - @class_history[:grouped_list].each do |cls_hist|
        br
        .tile.tile_ib
          .title #{ cls_hist[:classdef_name] }
          hr
          .stats
            div Classes Taught:    #{ cls_hist[:total_classes] }
            div Average Headcount: #{ cls_hist[:avr_headcount] }
          hr
          div 
            | MVP List: 
            .mvp_list
              - cls_hist[:mvp_list].each do |mvp|
                div.mvp
                  span #{ mvp[:count]         }
                  span #{ mvp[:customer_name] }

          div
            | History:
            .history_list
              - cls_hist[:hist_list].each do |hist|
                div.class_occ
                  span #{ hist[:starttime].strftime("%Y %a %b %e %l:%M %P") }
                  span #{ hist[:classdef_name] }
                  span #{ hist[:count]         }
