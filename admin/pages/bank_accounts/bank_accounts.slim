<!DOCTYPE html

html
  head
    == no_scaling

    title Profit and Loss

    == css [ 'fonts', 'site', 'header', 'admin/bank_accounts' ]
    == js  [ 'jquery', 'rivets', 'lib' ]
    script src='https://cdn.plaid.com/link/v2/stable/link-initialize.js'
    == js  [ 'element', 'ev_channel', '/auth/elements/userview', 'admin/bank_accounts' ]

  body
    #stars

    == include_slim('slim/partials/admin_header')

    #content
      .tile
        .title Profit and Loss

        .controls
          button rv-on-click='ctrl.add_account' Add Account
          input type='date' rv-value='data.start_date'
          input type='date' rv-value='data.end_date'
          button rv-on-click='ctrl.generate_cfc_pnl' rv-disabled='data.stripe_pnl_generating' Generate CFC P&L
          button rv-on-click='ctrl.generate_loft_pnl' rv-disabled='data.stripe_pnl_generating' Generate Loft P&L

        p.notice Connect account with Plaid Link, download CSV per account, and generate Stripe P&L sheets.

      .tile
        .title Connected Accounts

        table.accounts_table
          tbody
            tr
              th Institution
              th Name
              th Mask
              th Type
              th Added
              th Action
            tr rv-each-account='data.accounts'
              td[] { account.institution_name }
              td[] { account.official_name | fallback account.name }
              td[] { account.mask }
              td[] { account.type } / { account.subtype }
              td[] { account.added_at }
              td
                button rv-on-click='ctrl.download_csv' rv-data-account_id='account.account_id' Download CSV
                button rv-on-click='ctrl.remove_account' rv-data-account_id='account.account_id' Remove

      .tile rv-show='data.message'
        .title Status
        p[] { data.message }
