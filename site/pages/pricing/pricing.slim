<!DOCTYPE html>

html
  head

    == no_scaling

    title Cosmic Fit Club

    script src='https://js.stripe.com/v3/'
    javascript:
      var STRIPE_PUBLIC_KEY = '#{ ENV['STRIPE_PUBLIC'] }';
      var stripe = Stripe(STRIPE_PUBLIC_KEY);
      var elements = stripe.elements();

    ==css [ 'fonts', 'site', 'slick', 'slick-theme', 'header', 'footer', 'pricing' ]
    ==js  [ 'jquery', 'slick', 'rivets', 'lib', 'element', 'ev_channel', '/auth/elements/userview', '/admin/elements/popup_menu', '/checkout/elements/payment_form', 'menu', 'pricing' ]

  body.p5
    #stars
    
    == include_slim('slim/partials/header')
      
    .content

      .tile.passes-tile
        .heading Class Passes

        p.passes-intro
          | Passes are our all-purpose currency — buy a bundle and use them however you like. They never expire and are transferrable.

        .pass-uses-grid
          .pass-use-card
            .pass-use-icon ①
            .pass-use-title 1 Pass
            .pass-use-desc 1 hour on the aerial point for one person
          .pass-use-card
            .pass-use-icon ②
            .pass-use-title 2 Passes
            .pass-use-desc 2 person-hours on the aerial point, <em>or</em> a full-day open floor session, <em>or</em> one person in any class

        hr

        .pass-picker-section
          label.picker-label for='pass-qty' How many passes would you like?
          .picker-row
            button#qty-minus.qty-btn − 
            input#pass-qty type='number' min='1' max='20' value='1'
            button#qty-plus.qty-btn +
          .deal-badge#deal-badge style='display:none;'
            | 🎉 20-Pass Deal — Save $40!
          .price-summary
            .price-line
              span#qty-display 1
              |  pass
              span#plural-s
              |  — 
              strong#price-display $12.00
            .price-note#price-note $12.00 each
          button#buy-passes-btn.buy-passes-button Buy Now

      br
      br

    #popupmenu_container

    == include_slim('slim/partials/footer')

    == analytics
